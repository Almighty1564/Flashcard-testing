{
  "version": "1.0.0",
  "phases": [
    {
      "id": "basics",
      "title": "Programming foundations",
      "description": "Understand programs before automating systems."
    },
    {
      "id": "python",
      "title": "The Python toolkit",
      "description": "Learn a concept, vary it, and solve fresh problems."
    },
    {
      "id": "local",
      "title": "Useful local tools",
      "description": "Combine the skills into real multi-file software."
    },
    {
      "id": "systems",
      "title": "Data, services & interfaces",
      "description": "Add persistence, reporting, and web integration."
    },
    {
      "id": "capstone",
      "title": "Independent delivery",
      "description": "Demonstrate, adapt, and hand over a working tool."
    }
  ],
  "objectives": [
    {
      "id": "cs-scratch",
      "kind": "foundation",
      "ref": "scratch",
      "phase": "basics",
      "requires": [],
      "goal": "Break a task into state, events, and repeatable steps."
    },
    {
      "id": "cs-c",
      "kind": "foundation",
      "ref": "c",
      "phase": "basics",
      "requires": [
        "cs-scratch"
      ],
      "goal": "Write, compile, and debug C programs with input, decisions, loops, and functions."
    },
    {
      "id": "cs-arrays",
      "kind": "foundation",
      "ref": "arrays",
      "phase": "basics",
      "requires": [
        "cs-c"
      ],
      "goal": "Store collections, respect bounds, and search records."
    },
    {
      "id": "cs-algorithms",
      "kind": "foundation",
      "ref": "algorithms",
      "phase": "basics",
      "requires": [
        "cs-c",
        "cs-arrays"
      ],
      "goal": "Choose, implement, and explain search and sorting behavior."
    },
    {
      "id": "cs-memory",
      "kind": "foundation",
      "ref": "memory",
      "phase": "basics",
      "requires": [
        "cs-c",
        "cs-arrays"
      ],
      "goal": "Handle pointers, allocation, and lifetime explicitly."
    },
    {
      "id": "cs-structures",
      "kind": "foundation",
      "ref": "structures",
      "phase": "basics",
      "requires": [
        "cs-arrays",
        "cs-algorithms",
        "cs-memory"
      ],
      "goal": "Choose a structure to suit the operations and ownership."
    },
    {
      "id": "cs-python",
      "kind": "foundation",
      "ref": "python",
      "phase": "basics",
      "requires": [
        "cs-c",
        "cs-arrays",
        "cs-structures"
      ],
      "goal": "Transfer your programming reasoning into Python."
    },
    {
      "id": "py-values",
      "kind": "python",
      "ref": "values",
      "phase": "python",
      "requires": [
        "cs-python"
      ],
      "goal": "Represent, convert and update small pieces of communications data."
    },
    {
      "id": "py-decisions",
      "kind": "python",
      "ref": "decisions",
      "phase": "python",
      "requires": [
        "cs-python",
        "py-values"
      ],
      "goal": "Make boundaries, missing evidence and decision order explicit."
    },
    {
      "id": "py-loops",
      "kind": "python",
      "ref": "loops",
      "phase": "python",
      "requires": [
        "cs-python",
        "py-values",
        "py-decisions"
      ],
      "goal": "Process a collection reliably, preserving order and boundaries."
    },
    {
      "id": "py-collections",
      "kind": "python",
      "ref": "collections",
      "phase": "python",
      "requires": [
        "cs-python",
        "py-loops"
      ],
      "goal": "Model device data and transform it without accidental information loss."
    },
    {
      "id": "py-strings",
      "kind": "python",
      "ref": "strings",
      "phase": "python",
      "requires": [
        "cs-python",
        "py-collections"
      ],
      "goal": "Turn text exports into meaningful, validated records."
    },
    {
      "id": "py-functions",
      "kind": "python",
      "ref": "functions",
      "phase": "python",
      "requires": [
        "cs-python",
        "py-collections",
        "py-strings"
      ],
      "goal": "Build callable components with clear parameters, returns, and ownership."
    },
    {
      "id": "py-sorting",
      "kind": "python",
      "ref": "sorting",
      "phase": "python",
      "requires": [
        "py-collections",
        "py-functions"
      ],
      "goal": "Choose order, tie-breaking, mutation and selection semantics deliberately."
    },
    {
      "id": "py-reliability",
      "kind": "python",
      "ref": "reliability",
      "phase": "python",
      "requires": [
        "py-decisions",
        "py-functions"
      ],
      "goal": "Handle faults explicitly and write tests that expose incorrect behavior."
    },
    {
      "id": "py-files",
      "kind": "python",
      "ref": "files",
      "phase": "python",
      "requires": [
        "py-strings",
        "py-collections",
        "py-reliability"
      ],
      "goal": "Work on disposable files with explicit formats, encodings and ownership."
    },
    {
      "id": "py-models",
      "kind": "python",
      "ref": "models",
      "phase": "python",
      "requires": [
        "py-functions",
        "py-collections"
      ],
      "goal": "Represent state and stream data through well-defined Python interfaces."
    },
    {
      "id": "py-addressing",
      "kind": "python",
      "ref": "addressing",
      "phase": "python",
      "requires": [
        "py-collections",
        "py-reliability"
      ],
      "goal": "Use standard address models and retain routing context."
    },
    {
      "id": "py-integration",
      "kind": "python",
      "ref": "integration",
      "phase": "python",
      "requires": [
        "py-models",
        "py-addressing",
        "py-reliability"
      ],
      "goal": "Combine interface-independent collection with honest, testable conclusions."
    },
